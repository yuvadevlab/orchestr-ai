{
  "name": "@orchestr-ai/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public API gateway boundary for OrchestrAI managing authentication, rate limiting, request validation, and service routing",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsup --watch --onSuccess \"node dist/index.js\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orchestr-ai/agent": "workspace:*",
    "@orchestr-ai/core": "workspace:*",
    "@orchestr-ai/database": "workspace:*",
    "@orchestr-ai/eval": "workspace:*",
    "@orchestr-ai/events": "workspace:*",
    "@orchestr-ai/grpc": "workspace:*",
    "@orchestr-ai/memory": "workspace:*",
    "@orchestr-ai/model-router": "workspace:*",
    "@orchestr-ai/models": "workspace:*",
    "@orchestr-ai/observability": "workspace:*",
    "@orchestr-ai/prompts": "workspace:*",
    "@orchestr-ai/queue": "workspace:*",
    "@orchestr-ai/rag": "workspace:*",
    "@orchestr-ai/regex": "workspace:*",
    "@orchestr-ai/runtime": "workspace:*",
    "@orchestr-ai/shared-types": "workspace:*",
    "@orchestr-ai/tools": "workspace:*",
    "@yuva-devlab/auth-server": "^1.1.0",
    "@yuva-devlab/billing": "^0.2.2",
    "@yuva-devlab/logger": "^1.3.1",
    "@yuva-devlab/resilience": "^0.2.0",
    "@yuva-devlab/semantic-cache": "^0.2.2",
    "dotenv": "^16.4.7",
    "ioredis": "^6.0.0",
    "ollama": "^0.6.3",
    "pg": "^8.23.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
