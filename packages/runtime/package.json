{
  "name": "@orchestr-ai/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Directed state-graph DAG execution runtime and state checkpointing engine for OrchestrAI",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orchestr-ai/agent": "workspace:*",
    "@orchestr-ai/core": "workspace:*",
    "@orchestr-ai/models": "workspace:*",
    "@orchestr-ai/shared-types": "workspace:*",
    "@orchestr-ai/tools": "workspace:*",
    "@yuva-devlab/logger": "^1.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
